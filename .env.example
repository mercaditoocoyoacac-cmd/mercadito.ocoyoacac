# Database
DATABASE_URL="postgresql://..."

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-secret"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="mercadito"

# Admin
ADMIN_SECRET_KEY=""

# Email (SMTP) for password reset — e.g. Gmail SMTP with app password
# For Gmail: create an app password at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="mercadito.ocoyoacac@gmail.com"
SMTP_PASS="your-16-char-app-password"
EMAIL_FROM="mercadito.ocoyoacac@gmail.com"
NEXT_PUBLIC_APP_URL="https://mercadito-ocoyoacac.vercel.app"

# AWS SNS for SMS
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# Firebase Admin (server) — full service account JSON string
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# Google reCAPTCHA v2
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Upstash Redis (rate limiting + caching)
# Create a free Redis database at https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://us1-xxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"
