// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  VENDOR
  DELIVERY
  ADMIN
}

enum StorePlan {
  FREE
  MEMBER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  additionalRoles String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  phone        String?
  address      String?
  city         String?
  state        String?
  zipCode      String?
  latitude    Float?
  longitude   Float?

  pushToken   String?
  emailVerified    Boolean @default(false)
  phoneVerified   Boolean @default(false)

  failedLoginAttempts Int     @default(0)
  lastFailedLoginAt   DateTime?
  lockoutUntil        DateTime?

  ineFrontUrl    String?
  ineBackUrl     String?
  ineNumber      String?
  trialUsed      Boolean  @default(false)
  availabilitySchedule Json?          @default("{}")

  stores        Store[]
  orders        Order[]       @relation("OrderCustomer")
  deliveries    Order[]       @relation("OrderDelivery")
  cartItems     CartItem[]
  sessions      Session[]
  devices      DeviceAuthorization[]
  notifications Notification[]
  verifications Verification[]
  chatMessages  ChatMessage[]
  supportMessages SupportMessage[]
  couponUsers CouponUser[]
  membershipCouponUsers MembershipCouponUser[]

  @@index([role])
  @@index([isActive])
  @@index([latitude], map: "User_latitude_idx")
  @@index([longitude], map: "User_longitude_idx")
  @@index([pushToken], map: "User_pushToken_idx")
}

model Store {
  id          String   @id @default(cuid())
  slug        String   @unique
  name       String
  category   String @default("CANASTA_BASICA")
  description String?
  phone      String?
  address    String?
  latitude   Float?
  longitude  Float?
  imageUrl   String?
  isActive   Boolean  @default(true)
  isPublished Boolean @default(false)
  isApproved Boolean @default(false)
  plan       StorePlan @default(FREE)
  acceptsMercadoPago Boolean @default(false)
  mercadoPagoStatus String @default("PENDING")
  mercadoPagoAccessToken String?
  mercadoPagoRefreshToken String?
  mercadoPagoPublicKey String?
  mercadoPagoAccountId String?
  acceptsTransferencia Boolean @default(false)
  transferBankName String?
  transferAccountHolder String?
  transferClabe String?
  openTime   String?
  closeTime  String?
  scheduleDays DayOfWeek[] @default([MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY])
  scheduleDetails Json?          @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  products     Product[]
  orders       Order[]
  promotions   Promotion[]
  subscription Subscription?
  paymentMethods StorePaymentMethod[]
  receipts     PaymentReceipt[]
  couponStores CouponStore[]

  @@index([ownerId])
  @@index([isActive, isPublished])
  @@index([slug])
  @@index([isApproved])
}

model StorePaymentMethod {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  processor   String   // MERCADO_PAGO, CLIP, BBVA, OPENPAY, CONEKTRA
  label       String
  credentials String   // encrypted JSON
  isActive    Boolean  @default(true)
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId])
  @@index([storeId, isActive])
}

model Category {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  icon      String   @default("🏪")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, isActive])
}

model Subscription {
  id            String             @id @default(cuid())
  status        SubscriptionStatus @default(EXPIRED)
  startDate     DateTime           @default(now())
  endDate       DateTime
  monthlyPriceCents Int            @default(83000)
  discountEndDate DateTime?
  paymentMethod String?
  paymentReference String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  receipts PaymentReceipt[]
}

model PaymentReceipt {
  id            String   @id @default(cuid())
  receiptNumber String   @unique // e.g. "REC-2026-00001"
  amountCents   Int
  currency      String   @default("MXN")
  description   String
  periodStart   DateTime
  periodEnd     DateTime
  couponCode    String?
  couponSavings Int?
  paymentMethod String?
  paymentReference String?
  status        String   @default("PAID") // PAID, REFUNDED
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([receiptNumber])
}

model DeviceAuthorization {
  id          String   @id @default(cuid())
  deviceId    String
  userAgent   String?
  ipAddress  String?
  isApproved Boolean  @default(false)
  lastSeen   DateTime @default(now())
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceCents  Int
  currency    String   @default("MXN")
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sku         String?
  barcode     String?
  stock       Int      @default(-1)
  isUnavailable Boolean @default(false)

  sellByWeight   Boolean @default(false)
  minWeightGrams Int     @default(100)
  maxWeightGrams Int     @default(5000)
  sortOrder      Int     @default(0)

  soldCount           Int      @default(0)
  isPromotion         Boolean  @default(false)
  promotionPriceCents Int?
  discountPercentage  Int?
  promotionStartDate  DateTime?
  promotionEndDate    DateTime?

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  variants   ProductVariant[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  promotionProducts PromotionProduct[]

  @@index([storeId])
  @@index([isActive])
  @@index([storeId, isActive])
  @@index([sku])
  @@index([barcode])
}

model ProductVariant {
  id         String   @id @default(cuid())
  name       String
  priceCents Int
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model Promotion {
  id                 String   @id @default(cuid())
  title              String
  description        String?
  discountPercentage Int?
  imageUrl           String?
  isActive           Boolean  @default(true)
  requiresCoupon     Boolean  @default(false)
  startDate          DateTime?
  endDate            DateTime?
  lastPromoNotifiedAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  products PromotionProduct[]

  @@index([storeId])
  @@index([isActive])
}

model PromotionProduct {
  id     String @id @default(cuid())
  promoPriceCents Int?
  quantity        Int @default(1)

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([promotionId])
  @@index([productId])
}

model CartItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  weightGrams Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, productId, variantId, weightGrams])
  @@index([userId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String   // PERCENTAGE or FIXED
  discountValue Int      // percentage (1-100) or cents
  minPurchaseCents Int?
  maxUses       Int?
  usedCount     Int      @default(0)
  maxUsesPerUser Int?
  userRegisteredBefore DateTime?
  storeCreatedBefore  DateTime?
  isActive      Boolean  @default(true)
  startsAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stores  CouponStore[]
  users   CouponUser[]
  orders  Order[]

  @@index([isActive])
}

model CouponStore {
  id        String  @id @default(cuid())
  couponId  String
  storeId   String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([couponId, storeId])
  @@index([storeId])
}

model CouponUser {
  id        String  @id @default(cuid())
  couponId  String
  userId    String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId])
}

model MembershipCoupon {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String?
  discountType    String   // PERCENTAGE or FIXED
  discountValue   Int      // percentage (1-100) or cents off the membership price
  maxUses         Int?
  maxUsesPerStore Int?
  usedCount       Int      @default(0)
  userRegisteredBefore DateTime?
  storeCreatedBefore  DateTime?
  isActive        Boolean  @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users MembershipCouponUser[]
}

model MembershipCouponUser {
  id        String           @id @default(cuid())
  couponId  String
  userId    String
  coupon    MembershipCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId])
}

model Order {
  id              String          @id @default(cuid())
  status          OrderStatus     @default(PENDING)
  fulfillmentType FulfillmentType
  paymentMethod   String          @default("CASH")
  paymentEvidenceUrl String?
  paymentReference String?
  paymentVerified Boolean         @default(false)
  paymentVerifiedAt DateTime?
  customerName    String
  customerPhone   String
  customerAddress String?
  customerLat    Float?
  customerLng    Float?
  notes           String?
  subtotalCents   Int
  deliveryCents   Int             @default(0)
  totalCents      Int
  currency        String          @default("MXN")
  deliveryCode    String?         @unique
  pickupCode      String?         @unique
  statusTimestamps Json?          @default("{}")
  arrivedAt              DateTime?
  arrivalConfirmedAt     DateTime?
  couponDiscountCents    Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  userId  String
  user    User    @relation("OrderCustomer", fields: [userId], references: [id], onDelete: Cascade)
  storeId String
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  deliveryUserId String?
  deliveryUser   User?   @relation("OrderDelivery", fields: [deliveryUserId], references: [id])

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  items OrderItem[]
  rating OrderRating?
  messages ChatMessage[]

  @@index([userId])
  @@index([storeId])
  @@index([deliveryUserId])
  @@index([status])
  @@index([storeId, status])
  @@index([deliveryUserId, status])
  @@index([createdAt])
  @@index([customerLat])
  @@index([customerLng])
}

model OrderRating {
  id               String   @id @default(cuid())
  storeScore       Int
  packagingScore   Int?
  completenessScore Int?
  deliveryScore    Int?
  timelinessScore  Int?
  comment          String?
  createdAt        DateTime @default(now())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id          String   @id @default(cuid())
  name        String
  priceCents  Int
  quantity    Int
  weightGrams Int?
  variantName String?

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   @default("GENERAL")
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime  @default(now())

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model Verification {
  id        String   @id @default(cuid())
  type      String
  target    String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([target])
}

model SupportMessage {
  id            String   @id @default(cuid())
  message       String
  contactEmail  String?
  contactPhone  String?
  imageUrl      String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([read])
}

model DeliveryZone {
  id         String   @id @default(cuid())
  name       String
  color      String   @default("#22c55e")
  priceCents Int
  polygon    Json
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
}

model DeliverySettings {
  id                        Int      @id @default(1)
  baseFeeCents              Int      @default(2500)
  extraFeePerSegmentCents   Int      @default(1000)
  baseDistanceKm            Float    @default(2)
  segmentKm                 Float    @default(2)
  fallbackFeeCents          Int      @default(2500)
  updatedAt                 DateTime @updatedAt
}

model ChatMessage {
  id         String   @id @default(cuid())
  orderId    String
  senderId   String
  senderRole String
  message    String
  createdAt  DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([orderId])
}
