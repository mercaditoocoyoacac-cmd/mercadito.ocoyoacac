// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  VENDOR
  DELIVERY
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  phone        String?
  address      String?
  city         String?
  state        String?
  zipCode      String?

  emailVerified    Boolean @default(false)
  phoneVerified   Boolean @default(false)

  stores        Store[]
  orders        Order[]       @relation("OrderCustomer")
  deliveries    Order[]       @relation("OrderDelivery")
  cartItems     CartItem[]
  sessions      Session[]
  devices      DeviceAuthorization[]
  notifications Notification[]
  verifications Verification[]
}

model Store {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  phone       String?
  address     String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  isPublished Boolean  @default(false)
  acceptsMercadoPago Boolean @default(false)
  mercadoPagoStatus String @default("PENDING")
  mercadoPagoAccessToken String?
  mercadoPagoRefreshToken String?
  mercadoPagoPublicKey String?
  mercadoPagoAccountId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  products     Product[]
  orders       Order[]
  subscription Subscription?

  @@index([ownerId])
}

model Subscription {
  id            String             @id @default(cuid())
  status        SubscriptionStatus @default(EXPIRED)
  startDate     DateTime           @default(now())
  endDate       DateTime
  monthlyPriceCents Int            @default(15000)
  paymentMethod String?
  paymentReference String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model DeviceAuthorization {
  id          String   @id @default(cuid())
  deviceId    String
  userAgent   String?
  ipAddress  String?
  isApproved Boolean  @default(false)
  lastSeen   DateTime @default(now())
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceCents  Int
  currency    String   @default("MXN")
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([storeId])
}

model CartItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Order {
  id              String          @id @default(cuid())
  status          OrderStatus     @default(PENDING)
  fulfillmentType FulfillmentType
  paymentMethod   String          @default("CASH")
  customerName    String
  customerPhone   String
  customerAddress String?
  notes           String?
  subtotalCents   Int
  deliveryCents   Int             @default(0)
  totalCents      Int
  currency        String          @default("MXN")
  deliveryCode    String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  userId  String
  user    User    @relation("OrderCustomer", fields: [userId], references: [id], onDelete: Cascade)
  storeId String
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  deliveryUserId String?
  deliveryUser   User?   @relation("OrderDelivery", fields: [deliveryUserId], references: [id])

  items OrderItem[]

  @@index([userId])
  @@index([storeId])
  @@index([deliveryUserId])
}

model OrderItem {
  id         String   @id @default(cuid())
  name       String
  priceCents Int
  quantity   Int

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   @default("GENERAL")
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime  @default(now())

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model Verification {
  id        String   @id @default(cuid())
  type      String
  target    String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([target])
}
